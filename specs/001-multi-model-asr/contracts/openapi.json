{
  "components": {
    "schemas": {
      "Body_transcribe_api_v1_transcribe_post": {
        "properties": {
          "file": {
            "contentMediaType": "application/octet-stream",
            "title": "File",
            "type": "string"
          },
          "model": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Model"
          }
        },
        "required": [
          "file"
        ],
        "title": "Body_transcribe_api_v1_transcribe_post",
        "type": "object"
      },
      "ErrorCode": {
        "enum": [
          "INVALID_FORMAT",
          "FILE_TOO_LARGE",
          "AUDIO_TOO_LONG",
          "MODEL_NOT_FOUND",
          "MODEL_UNAVAILABLE",
          "MODEL_BUSY",
          "NO_DEFAULT_MODEL",
          "TRANSCRIPTION_FAILED"
        ],
        "title": "ErrorCode",
        "type": "string"
      },
      "ErrorEnvelope": {
        "properties": {
          "code": {
            "$ref": "#/components/schemas/ErrorCode"
          },
          "correlation_id": {
            "description": "UUIDv4 mirroring X-Correlation-Id",
            "title": "Correlation Id",
            "type": "string"
          },
          "details": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Details"
          },
          "message": {
            "title": "Message",
            "type": "string"
          }
        },
        "required": [
          "code",
          "message",
          "correlation_id"
        ],
        "title": "ErrorEnvelope",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "HealthzResponse": {
        "properties": {
          "status": {
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status"
        ],
        "title": "HealthzResponse",
        "type": "object"
      },
      "ModelDescriptor": {
        "properties": {
          "identifier": {
            "title": "Identifier",
            "type": "string"
          },
          "languages": {
            "items": {
              "type": "string"
            },
            "title": "Languages",
            "type": "array"
          },
          "last_error": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Last Error"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "state": {
            "$ref": "#/components/schemas/ModelState"
          },
          "vendor": {
            "title": "Vendor",
            "type": "string"
          }
        },
        "required": [
          "identifier",
          "name",
          "vendor",
          "languages",
          "state"
        ],
        "title": "ModelDescriptor",
        "type": "object"
      },
      "ModelListResponse": {
        "properties": {
          "default": {
            "title": "Default",
            "type": "string"
          },
          "models": {
            "items": {
              "$ref": "#/components/schemas/ModelDescriptor"
            },
            "title": "Models",
            "type": "array"
          }
        },
        "required": [
          "default",
          "models"
        ],
        "title": "ModelListResponse",
        "type": "object"
      },
      "ModelState": {
        "enum": [
          "LOADING",
          "READY",
          "FAILED"
        ],
        "title": "ModelState",
        "type": "string"
      },
      "TranscriptionResult": {
        "properties": {
          "audio_duration_s": {
            "minimum": 0.0,
            "title": "Audio Duration S",
            "type": "number"
          },
          "correlation_id": {
            "title": "Correlation Id",
            "type": "string"
          },
          "downmix_applied": {
            "title": "Downmix Applied",
            "type": "boolean"
          },
          "inference_duration_s": {
            "minimum": 0.0,
            "title": "Inference Duration S",
            "type": "number"
          },
          "language": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Language"
          },
          "model": {
            "title": "Model",
            "type": "string"
          },
          "no_speech_detected": {
            "title": "No Speech Detected",
            "type": "boolean"
          },
          "text": {
            "title": "Text",
            "type": "string"
          }
        },
        "required": [
          "text",
          "model",
          "audio_duration_s",
          "inference_duration_s",
          "downmix_applied",
          "no_speech_detected",
          "correlation_id"
        ],
        "title": "TranscriptionResult",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "ASR \u2014 Multi-Model Speech Transcription",
    "version": "1.0.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/healthz": {
      "get": {
        "operationId": "healthz_api_v1_healthz_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthzResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Healthz"
      }
    },
    "/api/v1/models": {
      "get": {
        "operationId": "list_models_api_v1_models_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ModelListResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "List Models"
      }
    },
    "/api/v1/transcribe": {
      "post": {
        "operationId": "transcribe_api_v1_transcribe_post",
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/Body_transcribe_api_v1_transcribe_post"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TranscriptionResult"
                }
              }
            },
            "description": "Successful Response"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "Invalid input (bad format or audio too long)."
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "Requested model is not registered."
          },
          "413": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "Upload exceeds the configured maximum file size."
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "Unexpected transcription failure."
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "Model is unavailable, busy, or no default model is available."
          }
        },
        "summary": "Transcribe a single audio file"
      }
    }
  }
}
